# Existing authorized Telegram user session. Keep secrets out of source control.
TG_API_ID=
TG_API_HASH=
TG_SESSION=sessions/mapexp
# One OpenRouter key authenticates Jev decisions and text synthesis.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
OPENROUTER_MODEL=openai/gpt-5.6-luna-pro
CITY_NAME=Пермь
CITY_TIMEZONE=Europe/Moscow
CITY_LAT=58.0105
CITY_LON=56.2502
CITY_ZOOM=11
DATABASE_PATH=data/mapexp.sqlite3
MEDIA_DIR=media
# A real operator contact is required before using public Nominatim.
GEOCODER_USER_AGENT=MapExp/1.0 (replace-with-your-email@example.com)
